{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": [
    "app/**/*.js",
    "app/**/*.jsx",
    "components/**/*.js",
    "components/**/*.jsx",
    "lib/**/*.js",
    "lib/**/*.jsx",
    "*.js",
    "*.jsx",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
